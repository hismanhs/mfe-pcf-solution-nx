{
  "name": "mfe-compliance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mfe-compliance/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/mfe-compliance", "command": "npm run build" },
      "outputs": ["{projectRoot}/dist"]
    },
    "start": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/mfe-compliance", "command": "npm start" }
    }
  },
  "tags": ["type:mfe", "scope:swift-compliance"]
}
